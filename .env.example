# Local-only values. pnpm infra:up generates .env with random values and never prints them.
# Never commit .env or replace these placeholders in this example file with real credentials.
POSTGRES_SUPERUSER_PASSWORD=replace-with-generated-local-secret
NEXUS_MIGRATOR_PASSWORD=replace-with-generated-local-secret
NEXUS_API_PASSWORD=replace-with-generated-local-secret
NEXUS_WORKER_PASSWORD=replace-with-generated-local-secret
ENTERPRISE_MIGRATOR_PASSWORD=replace-with-generated-local-secret
ENTERPRISE_APP_PASSWORD=replace-with-generated-local-secret
RABBITMQ_DEFAULT_USER=nexus_app
RABBITMQ_DEFAULT_PASS=replace-with-generated-local-secret
VALKEY_PASSWORD=replace-with-generated-local-secret
VALKEY_HOST=127.0.0.1
VALKEY_PORT=56379
NEXUS_COOKIE_SECURE=false
NEXUS_API_ORIGIN=http://127.0.0.1:3001
NEXUS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXUS_DB_HOST=127.0.0.1
NEXUS_DB_PORT=55432
NEXUS_DB_NAME=nexus
NEXUS_API_DB_USER=nexus_api
NEXUS_API_DB_PASSWORD=replace-with-generated-local-secret
NEXUS_WORKER_DB_USER=nexus_worker
NEXUS_WORKER_DB_PASSWORD=replace-with-generated-local-secret
ENTERPRISE_DB_HOST=127.0.0.1
ENTERPRISE_DB_PORT=55432
ENTERPRISE_DB_NAME=nexus
ENTERPRISE_APP_DB_USER=enterprise_app
ENTERPRISE_APP_DB_PASSWORD=replace-with-generated-local-secret
NEXUS_OWNER=local
NEXUS_PG_DEV_PORT=55432
NEXUS_RABBIT_DEV_PORT=55672
NEXUS_RABBIT_MANAGEMENT_DEV_PORT=55673
NEXUS_VALKEY_DEV_PORT=56379
