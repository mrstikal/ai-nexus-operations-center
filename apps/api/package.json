{
  "name": "@nexus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "nest start --watch --preserveWatchOutput --env-file ../../.env"
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@nexus/application": "workspace:*",
    "@nexus/contracts": "workspace:*",
    "@nexus/db": "workspace:*",
    "@nexus/integrations": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@types/node": "26.6.11"
  }
}
