# syntax=docker/dockerfile:1

FROM postgres:18.7-bookworm@sha256:e742a2668255221388004f3a42b6150a2103f5054ab3a4a93ae9e4f01e551c35 AS pgvector-builder

ARG PGVECTOR_VERSION=0.8.7
ARG PGVECTOR_SHA256=cac0b10c360f05b2d521200105ba3697e773d4cd3731f5a915a7e37ebe0bea85

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      postgresql-server-dev-18 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/pgvector.tar.gz \
      "https://github.com/pgvector/pgvector/archive/refs/tags/v${PGVECTOR_VERSION}.tar.gz" \
    && echo "${PGVECTOR_SHA256}  /tmp/pgvector.tar.gz" | sha256sum -c - \
    && mkdir -p /tmp/pgvector \
    && tar -xzf /tmp/pgvector.tar.gz -C /tmp/pgvector --strip-components=1 \
    && make -C /tmp/pgvector OPTFLAGS="" \
    && make -C /tmp/pgvector OPTFLAGS="" install

FROM postgres:18.7-bookworm@sha256:e742a2668255221388004f3a42b6150a2103f5054ab3a4a93ae9e4f01e551c35

LABEL org.opencontainers.image.title="NEXUS PostgreSQL with pgvector"
LABEL org.opencontainers.image.description="PostgreSQL 18.7 with pgvector 0.8.7 built from a pinned source archive"

COPY --from=pgvector-builder /usr/lib/postgresql/18/lib/vector.so /usr/lib/postgresql/18/lib/vector.so
COPY --from=pgvector-builder /usr/share/postgresql/18/extension/vector.control /usr/share/postgresql/18/extension/vector.control
COPY --from=pgvector-builder /usr/share/postgresql/18/extension/vector--*.sql /usr/share/postgresql/18/extension/
