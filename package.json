{
  "name": "nexus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.23.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "lint": "node tools/check-format.mjs && eslint . && node tools/check-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "test:unit": "pnpm --filter @nexus/contracts --filter @nexus/domain build && vitest run --project unit",
    "test:integration": "node tools/run-integration.mjs",
    "test:e2e": "node tools/run-e2e.mjs",
    "verify:phase": "node tools/run-phase.mjs",
    "docs:check": "pnpm --filter @nexus/contracts build && node tools/check-docs.mjs",
    "licenses:check": "node tools/check-licenses.mjs",
    "infra:up": "node tools/infra-up.mjs",
    "db:migrate": "pnpm --filter @nexus/db --filter @nexus/enterprise-db build && node tools/demo-init.mjs --migrate-only",
    "demo:init": "pnpm --filter @nexus/db --filter @nexus/enterprise-db --filter @nexus/application build && node tools/demo-init.mjs",
    "demo:reset": "node tools/not-implemented.mjs demo:reset F56",
    "eval:offline": "node tools/not-implemented.mjs eval:offline F52",
    "retrieval:check": "node tools/not-implemented.mjs retrieval:check F27",
    "eval:live": "node tools/not-implemented.mjs eval:live F54",
    "openapi:generate": "pnpm --filter @nexus/contracts build && node tools/generate-openapi.mjs"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@eslint/js": "10.0.1",
    "@nexus/ai": "workspace:*",
    "@nexus/application": "workspace:*",
    "@nexus/contracts": "workspace:*",
    "@nexus/db": "workspace:*",
    "@nexus/domain": "workspace:*",
    "@nexus/enterprise-db": "workspace:*",
    "@nexus/integrations": "workspace:*",
    "@nexus/observability": "workspace:*",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.11",
    "@types/pg": "8.23.1",
    "@types/redis-errors": "1.2.3",
    "amqplib": "2.4.2",
    "eslint": "10.15.0",
    "ioredis": "6.1.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "zod": "4.6.7",
    "@nexus/messaging": "workspace:*"
  }
}
