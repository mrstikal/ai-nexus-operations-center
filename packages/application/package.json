{
  "name": "@nexus/application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./identity/sessions": {
      "types": "./dist/identity/sessions.d.ts",
      "default": "./dist/identity/sessions.js"
    },
    "./identity/passwords": {
      "types": "./dist/identity/passwords.d.ts",
      "default": "./dist/identity/passwords.js"
    },
    "./identity/permissions": {
      "types": "./dist/identity/permissions.d.ts",
      "default": "./dist/identity/permissions.js"
    },
    "./cases/service": {
      "types": "./dist/cases/service.d.ts",
      "default": "./dist/cases/service.js"
    },
    "./cases/context": {
      "types": "./dist/cases/context.d.ts",
      "default": "./dist/cases/context.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nexus/contracts": "workspace:*",
    "@nexus/domain": "workspace:*",
    "@nexus/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.11"
  }
}
