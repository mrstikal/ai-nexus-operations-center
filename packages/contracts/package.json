{
  "name": "@nexus/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "default": "./dist/common.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./cases": {
      "types": "./dist/cases.d.ts",
      "default": "./dist/cases.js"
    },
    "./evidence": {
      "types": "./dist/evidence.d.ts",
      "default": "./dist/evidence.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "default": "./dist/workflows.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "default": "./dist/actions.js"
    },
    "./enterprise-commands": {
      "types": "./dist/enterprise-commands.d.ts",
      "default": "./dist/enterprise-commands.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./events/*": {
      "types": "./dist/events/*.d.ts",
      "default": "./dist/events/*.js"
    },
    "./ingress": {
      "types": "./dist/ingress.d.ts",
      "default": "./dist/ingress.js"
    },
    "./run-control": {
      "types": "./dist/run-control.d.ts",
      "default": "./dist/run-control.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.11"
  }
}
