{
  "name": "@nexus/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./clock": {
      "types": "./dist/clock.d.ts",
      "default": "./dist/clock.js"
    },
    "./state-machines": {
      "types": "./dist/state-machines.d.ts",
      "default": "./dist/state-machines.js"
    },
    "./canonical-json": {
      "types": "./dist/canonical-json.d.ts",
      "default": "./dist/canonical-json.js"
    },
    "./policies/action-validation": {
      "types": "./dist/policies/action-validation.d.ts",
      "default": "./dist/policies/action-validation.js"
    },
    "./policies/approvals": {
      "types": "./dist/policies/approvals.d.ts",
      "default": "./dist/policies/approvals.js"
    },
    "./actions/bindings": {
      "types": "./dist/actions/bindings.d.ts",
      "default": "./dist/actions/bindings.js"
    },
    "./actions/item-hash": {
      "types": "./dist/actions/item-hash.d.ts",
      "default": "./dist/actions/item-hash.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nexus/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.11"
  }
}
