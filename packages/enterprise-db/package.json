{
  "name": "@nexus/enterprise-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./connection": {
      "types": "./dist/connection.d.ts",
      "default": "./dist/connection.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    },
    "./schema/supply": {
      "types": "./dist/schema/supply.d.ts",
      "default": "./dist/schema/supply.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "@types/pg": "8.23.1"
  }
}
