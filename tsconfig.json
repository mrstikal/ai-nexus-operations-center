{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@nexus/db/connection": [
        "./packages/db/src/connection.ts"
      ],
      "@nexus/db/migrate": [
        "./packages/db/src/migrate.ts"
      ],
      "@nexus/enterprise-db/connection": [
        "./packages/enterprise-db/src/connection.ts"
      ],
      "@nexus/enterprise-db/migrate": [
        "./packages/enterprise-db/src/migrate.ts"
      ],
      "@nexus/enterprise-db/seed": [
        "./packages/enterprise-db/src/seed.ts"
      ],
      "@nexus/enterprise-db/schema/supply": [
        "./packages/enterprise-db/src/schema/supply.ts"
      ],
      "@nexus/enterprise-db/schema/commands": [
        "./packages/enterprise-db/src/schema/commands.ts"
      ],
      "@nexus/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@nexus/contracts/events": [
        "./packages/contracts/src/events/index.ts"
      ],
      "@nexus/contracts/events/*": [
        "./packages/contracts/src/events/*.ts"
      ],
      "@nexus/contracts/*": [
        "./packages/contracts/src/*.ts"
      ],
      "@nexus/domain": [
        "./packages/domain/src/index.ts"
      ],
      "@nexus/domain/*": [
        "./packages/domain/src/*.ts"
      ],
      "@nexus/db/schema/identity": [
        "./packages/db/src/schema/identity.ts"
      ],
      "@nexus/application/identity/sessions": [
        "./packages/application/src/identity/sessions.ts"
      ],
      "@nexus/application/identity/passwords": [
        "./packages/application/src/identity/passwords.ts"
      ],
      "@nexus/application/identity/permissions": [
        "./packages/application/src/identity/permissions.ts"
      ],
      "@nexus/integrations/rate-limits": [
        "./packages/integrations/src/rate-limits.ts"
      ],
      "@nexus/db/repositories/identity": [
        "./packages/db/src/repositories/identity.ts"
      ],
      "@nexus/observability/redaction": [
        "./packages/observability/src/redaction.ts"
      ],
      "@nexus/observability/trace": [
        "./packages/observability/src/trace.ts"
      ],
      "@nexus/db/schema/cases": [
        "./packages/db/src/schema/cases.ts"
      ],
      "@nexus/db/schema/evidence": [
        "./packages/db/src/schema/evidence.ts"
      ],
      "@nexus/db/schema/audit": [
        "./packages/db/src/schema/audit.ts"
      ],
      "@nexus/db/schema/trace": [
        "./packages/db/src/schema/trace.ts"
      ],
      "@nexus/db/repositories/cases": [
        "./packages/db/src/repositories/cases.ts"
      ],
      "@nexus/db/repositories/evidence": [
        "./packages/db/src/repositories/evidence.ts"
      ],
      "@nexus/db/repositories/audit": [
        "./packages/db/src/repositories/audit.ts"
      ],
      "@nexus/db/repositories/trace": [
        "./packages/db/src/repositories/trace.ts"
      ],
      "@nexus/application/cases/service": [
        "./packages/application/src/cases/service.ts"
      ],
      "@nexus/application/cases/context": [
        "./packages/application/src/cases/context.ts"
      ],
      "@nexus/application/ports/enterprise": [
        "./packages/application/src/ports/enterprise.ts"
      ],
      "@nexus/application/ports/tools": [
        "./packages/application/src/ports/tools.ts"
      ],
      "@nexus/integrations/enterprise/client": [
        "./packages/integrations/src/enterprise/client.ts"
      ],
      "@nexus/integrations/enterprise/errors": [
        "./packages/integrations/src/enterprise/errors.ts"
      ],
      "@nexus/integrations/tools/registry": [
        "./packages/integrations/src/tools/registry.ts"
      ],
      "@nexus/integrations/tools/enterprise-reads": [
        "./packages/integrations/src/tools/enterprise-reads.ts"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "tests/**/*.ts",
    "tools/**/*.mjs",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "tests/fixtures/**",
    "node_modules",
    "apps",
    "dist",
    ".next"
  ]
}
