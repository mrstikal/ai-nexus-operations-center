{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "paths": {
      "@nexus/db/connection": ["./packages/db/src/connection.ts"],
      "@nexus/db/migrate": ["./packages/db/src/migrate.ts"],
      "@nexus/enterprise-db/connection": ["./packages/enterprise-db/src/connection.ts"],
      "@nexus/enterprise-db/migrate": ["./packages/enterprise-db/src/migrate.ts"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "tools/**/*.mjs",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "tests/fixtures/**",
    "node_modules",
    "apps",
    "dist",
    ".next"
  ]
}
